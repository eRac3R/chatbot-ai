# Get a free key from https://aistudio.google.com/apikey (no credit card
# required for the free tier)
GEMINI_API_KEY=

# Model to use for chat replies
GEMINI_MODEL=gemini-2.5-flash

# Secret key required in the "x-admin-key" header to create/edit clients
# via /api/admin/*. Set this to a long random string before deploying.
ADMIN_KEY=change-me-to-a-long-random-secret

# Port the server listens on
PORT=3000

# Comma-separated list of origins allowed to call /api/chat and
# /api/clients/:id/public from the browser. Use "*" to allow any site
# to embed the widget (normal for a public plug-and-play widget).
ALLOWED_ORIGINS=*
