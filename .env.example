# Create a key at https://aistudio.google.com (Get API key). Used for every
# AI call: chat replies, suggested replies, and FAQ generation.
GEMINI_API_KEY=

# Model to use for chat replies. Any Gemini model that supports the
# OpenAI-compatible endpoint works; the default is the cheap, fast Flash-Lite.
GEMINI_MODEL=gemini-flash-lite-latest

# Secret key required in the "x-admin-key" header to create/edit clients
# via /api/admin/*. Set this to a long random string before deploying.
ADMIN_KEY=change-me-to-a-long-random-secret

# Port the server listens on
PORT=3000

# Comma-separated list of origins allowed to call /api/chat and
# /api/clients/:id/public from the browser. Use "*" to allow any site
# to embed the widget (normal for a public plug-and-play widget).
ALLOWED_ORIGINS=*

# Optional. Leave both blank for local dev -- client knowledge bases save to
# server/data/clients/*.json and chat memory stays in process memory.
# REQUIRED when deploying to Vercel (or any host without a persistent disk/
# long-lived process) -- get a free database at https://console.upstash.com
# (Redis) and paste its REST URL + token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How many days of total inactivity before a conversation is dropped from
# storage entirely -- the "fully closed, gone for good" tier. Expiry slides
# forward on every new message (including the system messages the two
# settings below post), so this means "idle for N days", not "N days since
# it started". Default 1.
SESSION_TTL_DAYS=1

# Once a live agent has joined a conversation, how many minutes of visitor
# silence before it temporarily pauses -- the "reopenable" tier. The agent
# is released and it drops out of the queue, but it's NOT gone: the visitor
# reopens it just by sending another message, at which point it's waiting
# again and any agent (not necessarily the one who had it before) can claim
# it. Default 30.
AGENT_IDLE_TIMEOUT_MINUTES=30

# Secret used to sign agent-CRM login cookies (/app.html). Set this to a
# long random string in production -- rotating it signs everyone out.
# If left blank, one is derived from ADMIN_KEY so local dev needs no setup.
SESSION_SECRET=
