# Get a free key from https://aistudio.google.com/apikey (no credit card
# required for the free tier)
GEMINI_API_KEY=

# Model to use for chat replies
GEMINI_MODEL=gemini-flash-lite-latest

# Secret key required in the "x-admin-key" header to create/edit clients
# via /api/admin/*. Set this to a long random string before deploying.
ADMIN_KEY=change-me-to-a-long-random-secret

# Port the server listens on
PORT=3000

# Comma-separated list of origins allowed to call /api/chat and
# /api/clients/:id/public from the browser. Use "*" to allow any site
# to embed the widget (normal for a public plug-and-play widget).
ALLOWED_ORIGINS=*

# Optional. Leave both blank for local dev -- client knowledge bases save to
# server/data/clients/*.json and chat memory stays in process memory.
# REQUIRED when deploying to Vercel (or any host without a persistent disk/
# long-lived process) -- get a free database at https://console.upstash.com
# (Redis) and paste its REST URL + token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How many days of inactivity before a visitor's chat history is dropped.
# Expiry slides forward on every new message, so this means "idle for N
# days". Default 1.
SESSION_TTL_DAYS=1

# Once a live agent has joined a conversation, how many minutes of visitor
# silence before it auto-ends and locks. Default 10.
AGENT_IDLE_TIMEOUT_MINUTES=10
